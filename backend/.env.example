# Copy this file to .env and fill in the values
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string (free M0 cluster)
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/tuition_centre?retryWrites=true&w=majority

# Long random string used to sign login tokens
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Frontend origin(s), comma-separated (local dev + Vercel URL)
CLIENT_URL=http://localhost:5173,https://your-app.vercel.app

# Shown in WhatsApp messages
CENTRE_NAME=Smart Tuition Centre

# Password given to new users if none is entered in the admin form
DEFAULT_PASSWORD=changeme123

# WhatsApp Cloud API (Meta). Leave empty to run in dry-run mode (messages are logged, not sent)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
